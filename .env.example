# Root environment template for local development.
# Copy to .env and fill in real values. NEVER commit real secrets.

# --- PostgreSQL / PostGIS (matches docker-compose dev defaults) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecosphere?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# --- App ---
NODE_ENV="development"
PORT=4000
API_PUBLIC_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:5173"
# Reverse-proxy hops in front of the API. 0 = no proxy (local dev). Set to 1 in
# production behind Render/Vercel/nginx. Never set to true.
TRUST_PROXY_HOPS=0

# --- Cloudinary (evidence uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AI Service ---
AI_SERVICE_URL="http://localhost:8000"
# Shared secret the backend sends as X-AI-Service-Token; must match the
# AI_SERVICE_TOKEN in ai-service/.env. Generate your own for anything non-local:
# production startup rejects the known dev default.
AI_SERVICE_TOKEN="dev-ai-token"
AI_TIMEOUT_MS=90000
# Quiz generation can span multiple LLM chunks.
AI_QUIZ_TIMEOUT_MS=300000
# Consumed by the ai-service container only (docker compose passes it through).
# Leave empty for local work that does not call Groq. Never commit a real key.
AI_GROQ_API_KEY=""

# --- Cookies / logging ---
# "true" forces the refresh cookie Secure flag on (required behind HTTPS).
# Leave unset to follow NODE_ENV (Secure only in production).
COOKIE_SECURE=""
LOG_LEVEL="info"

# --- Admin seed (`npm run seed`) ---
# ADMIN_PASSWORD is REQUIRED by the seed and must be at least 8 characters.
ADMIN_EMAIL="admin@ecosphere.com"
ADMIN_PASSWORD=""
ADMIN_NAME="System Administrator"
