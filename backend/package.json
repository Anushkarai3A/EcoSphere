{
  "name": "@ecosphere/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "test": "tsx --test src/lib/aiGateway.test.ts src/lib/aiVerification.test.ts src/lib/proxyTrust.test.ts src/lib/verificationChecks.test.ts src/lib/verificationAward.test.ts src/config/secrets.test.ts src/middlewares/error.middleware.test.ts src/routes/auth.routes.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ../database/prisma/schema.prisma",
    "seed": "tsx src/seed/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.52.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "prisma": "^6.13.0",
    "tsx": "^4.19.4"
  }
}
