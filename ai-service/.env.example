# Copy to ai-service/.env and fill in your values.
#
# "production" rejects the known dev shared secret at startup. The bundled
# docker compose stack sets this to production.
AI_ENVIRONMENT=development

# Shared secret the backend sends as `X-AI-Service-Token`. Must match
# AI_SERVICE_TOKEN in backend/.env (backend default: dev-ai-token).
AI_SERVICE_TOKEN=dev-ai-token

# --- Groq (primary LLM provider) ---
AI_LLM_PROVIDER=groq
AI_GROQ_API_KEY=your-groq-api-key-here
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_MODEL=openai/gpt-oss-20b
AI_LLM_MAX_TOKENS=2048
AI_LLM_TIMEOUT=120

# --- Voiceover / text-to-speech ---
# Groq Orpheus is configured independently from AI_GROQ_MODEL.
# Groq accepts WAV only and limits each request to 200 characters; the service
# splits longer narration automatically.
AI_TTS_PROVIDER=groq
AI_TTS_MODEL=canopylabs/orpheus-v1-english
AI_TTS_VOICE=autumn
AI_TTS_FORMAT=wav

# --- Optional overrides ---
# AI_CONFIDENCE_THRESHOLD=0.5
# AI_MAX_EXTRACT_CHARS=120000
# AI_MAX_QUIZ_QUESTIONS=50
